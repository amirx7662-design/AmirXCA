<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AmirXCA Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        :root {
            --bg-body: #05080e;
            --card-bg: #0d131f;
            --accent-main: #00f2ff;
            --accent-green: #38ef7d;
            --accent-red: #ef4444;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Fira Code', monospace; }
        body { background-color: var(--bg-body); color: var(--text-main); padding-bottom: 60px; }

        header {
            background: #0b0f17;
            padding: 12px 20px;
            border-bottom: 2px solid var(--accent-main);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-title { color: var(--accent-main); font-size: 1.5rem; font-weight: bold; cursor: pointer; }
        .status-widget { font-size: 0.85rem; color: var(--accent-green); background: rgba(0, 242, 255, 0.05); padding: 6px 12px; border-radius: 6px; border: 1px solid rgba(0, 242, 255, 0.2); }

        .container { max-width: 1200px; margin: 20px auto; padding: 0 15px; }

        .tabs { display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px; }
        .tab-btn { background: var(--card-bg); color: var(--text-muted); border: 1px solid #1e293b; padding: 8px 16px; border-radius: 6px; cursor: pointer; white-space: nowrap; font-weight: bold; }
        .tab-btn.active, .tab-btn:hover { color: var(--accent-main); border-color: var(--accent-main); background: rgba(0,242,255,0.1); }

        .section { display: none; }
        .section.active { display: block; }

        .grid-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px; }
        .card { background: var(--card-bg); border: 1px solid #1e293b; border-radius: 8px; padding: 15px; }
        .card h3 { color: var(--accent-main); font-size: 1rem; margin-bottom: 8px; direction: ltr; text-align: left; }
        .card p { color: var(--text-muted); font-size: 0.8rem; margin-bottom: 12px; line-height: 1.4; direction: ltr; text-align: left; }

        .tool-input {
            width: 100%;
            background: #000;
            border: 1px solid #1e293b;
            color: var(--accent-green);
            padding: 8px;
            border-radius: 4px;
            margin-bottom: 10px;
            font-size: 0.85rem;
            outline: none;
            direction: ltr;
        }

        .tool-input:focus { border-color: var(--accent-main); }

        .btn-action { 
            display: block;
            text-align: center;
            background: var(--accent-main); 
            color: #000; 
            font-weight: bold; 
            border: none; 
            padding: 10px 12px; 
            border-radius: 4px; 
            cursor: pointer; 
            width: 100%; 
        }

        .tool-res {
            margin-top: 10px;
            background: #000;
            border: 1px dashed var(--accent-main);
            padding: 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            color: var(--accent-green);
            display: none;
            white-space: pre-wrap;
            word-break: break-all;
            direction: ltr;
            text-align: left;
        }

        /* Termux Emulator */
        #term-box { background: #000; border: 1px solid var(--accent-main); border-radius: 6px; padding: 15px; height: 320px; display: flex; flex-direction: column; direction: ltr; }
        #term-output { flex: 1; overflow-y: auto; color: var(--accent-green); font-size: 0.85rem; white-space: pre-wrap; }
        .term-input-line { display: flex; gap: 8px; margin-top: 5px; }
        .term-input { background: transparent; border: none; color: #fff; flex: 1; outline: none; }

        /* Reader Window */
        #reader-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #05080e; z-index: 300; flex-direction: column; padding: 20px; }
        .reader-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--accent-main); padding-bottom: 10px; margin-bottom: 15px; }
        .reader-body { flex: 1; overflow-y: auto; background: #0d131f; border: 1px solid #1e293b; padding: 20px; border-radius: 8px; line-height: 1.8; color: #e2e8f0; }

        /* Nano Window */
        #nano-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 200; flex-direction: column; direction: ltr; }
        .nano-head { background: #fff; color: #000; padding: 4px 10px; font-weight: bold; font-size: 0.85rem; }
        .nano-text { flex: 1; background: #000; color: #fff; border: none; padding: 10px; outline: none; font-family: monospace; resize: none; }
        .nano-foot { background: #1e293b; color: #fff; padding: 6px; font-size: 0.75rem; text-align: center; }
    </style>
</head>
<body>

    <header>
        <div class="logo-title" ondblclick="openSecretAdmin()">⚡ AmirXCA</div>
        <div class="status-widget">
            <span>Points: <strong id="user-xp" style="color:#fff;">290</strong> XP</span>
        </div>
    </header>

    <div class="container">

        <!-- الأقسام الرئيسية -->
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('tools', event)">🛠️ Services (30)</button>
            <button class="tab-btn" onclick="switchTab('terminal', event)">💻 Termux & Nano</button>
            <button class="tab-btn" onclick="switchTab('games', event)">🎮 Games (3D / 2D)</button>
            <button class="tab-btn" onclick="switchTab('books', event)">📚 Books Library</button>
            <button class="tab-btn" onclick="switchTab('sadaqah', event)">✨ Sadaqah Jariyah</button>
        </div>

        <!-- 1. قسم الأدوات والخدمات الـ 30 بالإنجليزي فقط -->
        <div id="sec-tools" class="section active">
            <div class="grid-container" id="tools-grid"></div>
        </div>

        <!-- 2. قسم Termux & Nano -->
        <div id="sec-terminal" class="section">
            <div class="card">
                <h3 style="direction:rtl; text-align:right;">💻 محاكي Termux ونظام Nano</h3>
                <p style="direction:rtl; text-align:right;">اكتب <code>help</code> لمعرفة الأوامر، أو <code>nano script.py</code> لفتح محرر النصوص.</p>
                <div id="term-box">
                    <div id="term-output">AmirX OS Terminal [Version 2.0]
Type 'help' for available commands.</div>
                    <div class="term-input-line">
                        <span style="color:var(--accent-main)">amirx@system:~$</span>
                        <input type="text" id="term-cmd" class="term-input" onkeydown="handleTerm(event)">
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. قسم الألعاب -->
        <div id="sec-games" class="section">
            <div class="grid-container">
                <div class="card">
                    <h3>Cyber Runner 2D</h3>
                    <p>Run 2D interactive arcade game inside the platform.</p>
                    <button class="btn-action" onclick="run2DGame()">Run 2D Game</button>
                    <canvas id="game2DCanvas" style="width:100%; height:140px; background:#000; margin-top:10px; border-radius:4px;"></canvas>
                </div>
                <div class="card">
                    <h3>3D Matrix Space Engine</h3>
                    <p>Built-in 3D engine running webGL code directly.</p>
                    <button class="btn-action" onclick="init3DGame()">Run 3D Engine</button>
                    <div id="canvas3DContainer" style="width:100%; height:140px; background:#000; margin-top:10px; border-radius:4px;"></div>
                </div>
            </div>
        </div>

        <!-- 4. قسم الكتب -->
        <div id="sec-books" class="section">
            <div class="grid-container">
                <div class="card">
                    <h3 style="direction:rtl; text-align:right;">كتاب صحيح مسلم</h3>
                    <p style="direction:rtl; text-align:right;">تحميل وقراءة كتاب صحيح مسلم كاملاً داخل المنصة.</p>
                    <button class="btn-action" onclick="openReader('صحيح مسلم', 'book_muslim')">تحميل وقراءة الكتاب</button>
                </div>
                <div class="card">
                    <h3 style="direction:rtl; text-align:right;">دليل برمجيات Python</h3>
                    <p style="direction:rtl; text-align:right;">كتاب تعليم البرمجة بالأمثلة العملية.</p>
                    <button class="btn-action" onclick="openReader('دليل Python', 'book_py')">عرض الكتاب</button>
                </div>
            </div>
        </div>

        <!-- 5. قسم أجر جاري -->
        <div id="sec-sadaqah" class="section">
            <div class="grid-container">
                <div class="card">
                    <h3 style="direction:rtl; text-align:right;">📖 المصحف الإلكتروني</h3>
                    <p style="direction:rtl; text-align:right;">قراءة واستماع للقرآن الكريم (صدقة جارية).</p>
                    <button class="btn-action" onclick="openReader('المصحف الإلكتروني', 'quran')">فتح المصحف</button>
                </div>
                <div class="card">
                    <h3 style="direction:rtl; text-align:right;">🤲 أذكار واستغفار</h3>
                    <p style="direction:rtl; text-align:right;">عداد الاستغفار والأذكار اليومية تلقائياً.</p>
                    <button class="btn-action" onclick="openReader('الأذكار والاستغفار', 'azkar')">بدء العداد</button>
                </div>
            </div>
        </div>

        <!-- لوحة التحكم السرية -->
        <div id="sec-admin" class="section" style="border: 1px solid var(--accent-red); padding: 15px; border-radius: 8px; background: #150505;">
            <h2 style="color:var(--accent-red); margin-bottom: 10px; direction:ltr;">🔒 Secret Admin Dashboard (AmirXX)</h2>
            <div class="grid-container">
                <div class="card">
                    <h3>Server & Bridge Control</h3>
                    <button class="btn-action" style="background:var(--accent-red); color:#fff;" onclick="alert('System server restarted successfully.')">Restart Server</button>
                </div>
            </div>
        </div>

    </div>

    <!-- نافذة القراءة المدمجة -->
    <div id="reader-modal">
        <div class="reader-head">
            <h2 id="reader-title" style="color:var(--accent-main)">Book Reader</h2>
            <button onclick="closeReader()" style="background:var(--accent-red); color:#fff; border:none; padding:6px 15px; font-weight:bold; cursor:pointer; border-radius:4px;">Close</button>
        </div>
        <div class="reader-body" id="reader-content"></div>
    </div>

    <!-- نافذة Nano Modal -->
    <div id="nano-modal">
        <div class="nano-head">GNU nano 9.2 &nbsp;&nbsp;&nbsp;&nbsp; File: <span id="nano-filename">script.py</span></div>
        <textarea id="nano-content" class="nano-text" spellcheck="false"></textarea>
        <div class="nano-foot">
            <button onclick="closeNano()" style="background:var(--accent-red); color:#fff; border:none; padding:5px 12px; font-weight:bold; cursor:pointer; border-radius:3px;">Exit Nano</button>
        </div>
    </div>

    <script>
        let xp = 290;

        function addXP() {
            xp += 10;
            document.getElementById('user-xp').innerText = xp;
        }

        const toolsGrid = document.getElementById('tools-grid');
        
        // قائمة الأدوات الـ 30 باللغة الإنجليزية حصراً بدون تكرار
        const toolsList = [
            { id: 1, name: 'Port Scanner', ph: 'Target IP (e.g., 127.0.0.1)' },
            { id: 2, name: 'IP Intelligence', ph: 'Target IP (e.g., 8.8.8.8)' },
            { id: 3, name: 'Hash Generator', ph: 'Enter string to hash...' },
            { id: 4, name: 'Base64 Converter', ph: 'Enter string to encode/decode...' },
            { id: 5, name: 'SQLi Vulnerability Tester', ph: 'Target URL...' },
            { id: 6, name: 'XSS Detector', ph: 'Target URL or payload...' },
            { id: 7, name: 'Subdomain Finder', ph: 'Target domain (example.com)' },
            { id: 8, name: 'DNS Lookup Tool', ph: 'Target domain...' },
            { id: 9, name: 'Packet Sniffer Engine', ph: 'Interface (e.g., eth0)' },
            { id: 10, name: 'HTTP Header Analyzer', ph: 'Target URL...' },
            { id: 11, name: 'SSL/TLS Checker', ph: 'Target domain...' },
            { id: 12, name: 'Ping Latency Test', ph: 'Target IP or domain...' },
            { id: 13, name: 'Traceroute Engine', ph: 'Target IP...' },
            { id: 14, name: 'MAC Address Lookup', ph: 'Target MAC...' },
            { id: 15, name: 'Whois Domain Search', ph: 'Target domain...' },
            { id: 16, name: 'URL Encoder/Decoder', ph: 'Enter URL string...' },
            { id: 17, name: 'JWT Token Decoder', ph: 'Enter JWT Token...' },
            { id: 18, name: 'User-Agent Inspector', ph: 'Enter User-Agent...' },
            { id: 19, name: 'CORS Misconfig Check', ph: 'Target URL...' },
            { id: 20, name: 'Payload Generator', ph: 'Type format (e.g., reverse_tcp)' },
            { id: 21, name: 'BruteForce Simulator', ph: 'Target user...' },
            { id: 22, name: 'Reverse Shell Handler', ph: 'Port listener...' },
            { id: 23, name: 'Robots.txt Parser', ph: 'Target domain...' },
            { id: 24, name: 'Sitemap Analyzer', ph: 'Target URL...' },
            { id: 25, name: 'Cookie Security Auditor', ph: 'Target URL...' },
            { id: 26, name: 'CSS/JS Minifier', ph: 'Enter code...' },
            { id: 27, name: 'Regex Pattern Tester', ph: 'Enter regex...' },
            { id: 28, name: 'Markdown Editor Engine', ph: 'Enter markdown...' },
            { id: 29, name: 'UUID Generator', ph: 'Click execute...' },
            { id: 30, name: 'API Endpoint Scanner', ph: 'Target Endpoint...' }
        ];

        // بناء الـ 30 أداة تفاعلية
        toolsList.forEach(t => {
            toolsGrid.innerHTML += `
                <div class="card">
                    <h3>#${t.id} ${t.name}</h3>
                    <p>Automated execution module.</p>
                    <input type="text" id="inp-${t.id}" class="tool-input" placeholder="${t.ph}">
                    <button class="btn-action" onclick="runTool(${t.id})">Execute Service</button>
                    <div class="tool-res" id="res-${t.id}"></div>
                </div>
            `;
        });

        function runTool(id) {
            addXP();
            let inp = document.getElementById(`inp-${id}`).value.trim();
            let resBox = document.getElementById(`res-${id}`);
            resBox.style.display = 'block';

            if(!inp) inp = "127.0.0.1";

            if(id === 1) {
                resBox.innerText = `[+] Port Scanning (${inp})...\n- Port 80 (HTTP): OPEN\n- Port 443 (HTTPS): OPEN\n- Port 22 (SSH): CLOSED\n[✓] Scan Completed.`;
            } else if(id === 2) {
                resBox.innerText = `[+] IP Analysis (${inp}):\n- Country: Local Host\n- ISP: System Network\n- Security: Secure`;
            } else if(id === 3) {
                resBox.innerText = `[+] String: ${inp}\n- Base64: ${btoa(inp)}\n- Hash: ${Math.random().toString(36).substring(2) + Math.random().toString(36).substring(2)}`;
            } else if(id === 4) {
                resBox.innerText = `[+] Converted Output:\n${btoa(inp)}`;
            } else if(id === 7) {
                resBox.innerText = `[+] Subdomains for (${inp}):\n- api.${inp}\n- admin.${inp}\n- dev.${inp}`;
            } else {
                resBox.innerText = `[+] Service #${id} executed on (${inp})\n- Status: 200 OK\n- Time: 0.02s\n[✓] Process completed.`;
            }
        }

        function switchTab(tabName, evt) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
            if(evt) evt.target.classList.add('active');
            document.getElementById('sec-' + tabName).classList.add('active');
        }

        function openReader(title, type) {
            addXP();
            document.getElementById('reader-title').innerText = title;
            let body = document.getElementById('reader-content');
            
            if(type === 'book_muslim') {
                body.innerHTML = `<h3>كتاب صحيح مسلم (مكتبة النظام المدمجة)</h3><br><p><b>مقدمة الإمام مسلم:</b> الحمد لله رب العالمين، والصلاة والسلام على رسول الله...<br><br><b>1. باب الإيمان:</b> "الإيمان أن تؤمن بالله وملائكته وكتبه ورسله واليوم الآخر وتؤمن بالقدر خيره وشره."</p>`;
            } else if(type === 'book_py') {
                body.innerHTML = `<h3>دليل برمجيات Python</h3><br><p><b>الدرس الأول: Output</b><br><code>print("Hello AmirX Platform")</code><br><br><b>الدرس الثاني: Operations</b><br><code>x = 10\ny = 20\nprint(x + y)</code></p>`;
            } else if(type === 'quran') {
                body.innerHTML = `<h3>المصحف الإلكتروني المدمج</h3><br><div style="text-align:center; font-size:1.2rem; line-height:2.2;"><p><b>سورة الفاتحة</b><br>بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ (1) الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ (2) الرَّحْمَٰنِ الرَّحِيمِ (3) مَالِكِ يَوْمِ الدِّينِ (4) إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ (5) اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ (6) صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ (7)</p></div>`;
            } else if(type === 'azkar') {
                body.innerHTML = `<h3>عداد الأذكار والأنظمة</h3><br><p>أستغفر الله العظيم وأتوب إليه (تم التكرار 100 مرة تلقائياً)<br>سبحان الله وبحمده سبحان الله العظيم (تم التكرار 100 مرة تلقائياً)</p>`;
            }

            document.getElementById('reader-modal').style.display = 'flex';
        }

        function closeReader() {
            document.getElementById('reader-modal').style.display = 'none';
        }

        function openSecretAdmin() {
            let pwd = prompt("Enter secret password:");
            if(pwd === "AmirXX") {
                document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
                document.getElementById('sec-admin').classList.add('active');
                alert("Access Granted!");
            } else if(pwd !== null) {
                alert("Access Denied!");
            }
        }

        function handleTerm(e) {
            if(e.key === 'Enter') {
                let input = document.getElementById('term-cmd');
                let out = document.getElementById('term-output');
                let cmd = input.value.trim();
                out.innerHTML += '\namirx@system:~$ ' + cmd;

                if(cmd === 'help') {
                    out.innerHTML += '\nCommands:\n - ls : list files\n - clear : clear screen\n - nano [filename] : text editor';
                } else if(cmd === 'ls') {
                    out.innerHTML += '\nindex.html   system.py   config.json';
                } else if(cmd === 'clear') {
                    out.innerHTML = 'Terminal Cleared.';
                } else if(cmd.startsWith('nano')) {
                    let fname = cmd.split(' ')[1] || 'script.py';
                    document.getElementById('nano-filename').innerText = fname;
                    document.getElementById('nano-modal').style.display = 'flex';
                } else if(cmd !== '') {
                    out.innerHTML += `\n${cmd}: command not found`;
                }

                input.value = '';
                document.getElementById('term-box').scrollTop = document.getElementById('term-box').scrollHeight;
            }
        }

        function closeNano() {
            document.getElementById('nano-modal').style.display = 'none';
            let out = document.getElementById('term-output');
            out.innerHTML += '\n[+] Exit Nano: Saved changes successfully.';
        }

        function run2DGame() {
            let canvas = document.getElementById('game2DCanvas');
            let ctx = canvas.getContext('2d');
            let x = 10;
            function animate() {
                ctx.clearRect(0,0,canvas.width,canvas.height);
                ctx.fillStyle = '#00f2ff';
                ctx.fillRect(x, 50, 20, 20);
                x = (x + 2) % canvas.width;
                requestAnimationFrame(animate);
            }
            animate();
        }

        function init3DGame() {
            let container = document.getElementById('canvas3DContainer');
            container.innerHTML = '';
            let scene = new THREE.Scene();
            let camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
            let renderer = new THREE.WebGLRenderer();
            renderer.setSize(container.clientWidth, container.clientHeight);
            container.appendChild(renderer.domElement);

            let geometry = new THREE.BoxGeometry();
            let material = new THREE.MeshBasicMaterial({ color: 0x00f2ff, wireframe: true });
            let cube = new THREE.Mesh(geometry, material);
            scene.add(cube);
            camera.position.z = 3;

            function animate3D() {
                requestAnimationFrame(animate3D);
                cube.rotation.x += 0.01;
                cube.rotation.y += 0.01;
                renderer.render(scene, camera);
            }
            animate3D();
        }
    </script>
</body>
</html>
